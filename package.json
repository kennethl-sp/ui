{
  "name": "@suryapamenang/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared React UI components, primitives and styles for Surya Pamenang applications.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm run build:styles && pnpm run build:components",
    "build:styles": "tailwindcss -i ./src/styles/styles.css -o ./dist/index.css",
    "build:components": "tsc",
    "check-types": "tsc --noEmit",
    "dev:styles": "tailwindcss -i ./src/styles/styles.css -o ./dist/index.css --watch",
    "dev:components": "tsc --watch",
    "clean": "rimraf dist",
    "format": "biome format . --write",
    "lint": "biome check .",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./dist/index.css",
    "./lib/utils": "./dist/lib/utils.js",
    "./primitives/*": "./dist/primitives/*.js",
    "./components/*": "./dist/components/*.js",
    "./*": "./dist/*.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@platejs/basic-nodes": "^51.1.2",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.537.0",
    "motion": "^12.43.0",
    "next-themes": "^0.4.6",
    "platejs": "^51.1.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.3",
    "react-dropzone": "^14.4.1",
    "react-hook-form": "^7.87.0",
    "recharts": "2.15.4",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@platejs/basic-nodes": "^51.1.2",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.537.0",
    "motion": "^12.43.0",
    "next-themes": "^0.4.6",
    "platejs": "^51.1.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.3",
    "react-dropzone": "^14.4.1",
    "react-hook-form": "^7.87.0",
    "recharts": "2.15.4",
    "rimraf": "^6.1.3",
    "sonner": "^2.0.8",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vaul": "^1.1.2"
  },
  "packageManager": "pnpm@10.28.2"
}
